<?xml version="1.0" encoding="utf-8"?>
<!-- Restores only from nuget.org, so package sources configured on a developer machine
     (extra feeds, missing offline folders) can never change or break a build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
