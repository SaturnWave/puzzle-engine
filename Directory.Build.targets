<Project>
  <!--
    Build-time guard for the engine rules (CoveredLot.md, shared engine §1 and §3). It runs
    before every compile and checks EVALUATED values, so a property set in any
    props/targets/rsp file, on the command line or in a project file is seen the same way
    the compiler sees it.

    Layering table: PuzzleAllowedProjectReferences lists, per project, the projects it may
    reference. tests/PuzzleCore.Tests/Support/ProjectRules keeps an identical table and a
    test checks that the two agree. Sort and Jam never reference each other.
  -->
  <PropertyGroup>
    <PuzzleIsSourceProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\','/').Contains('/src/'))</PuzzleIsSourceProject>
    <PuzzleIsUnityBound>false</PuzzleIsUnityBound>
    <PuzzleIsUnityBound Condition="'$(MSBuildProjectName)' == 'PuzzleCore' or '$(MSBuildProjectName)' == 'PuzzleCore.Jam'">true</PuzzleIsUnityBound>
    <PuzzleLayeringKnown>false</PuzzleLayeringKnown>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PuzzleCore'"><PuzzleLayeringKnown>true</PuzzleLayeringKnown><PuzzleAllowedProjectReferences></PuzzleAllowedProjectReferences></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PuzzleCore.Jam'"><PuzzleLayeringKnown>true</PuzzleLayeringKnown><PuzzleAllowedProjectReferences>PuzzleCore</PuzzleAllowedProjectReferences></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PuzzleCore.Cli'"><PuzzleLayeringKnown>true</PuzzleLayeringKnown><PuzzleAllowedProjectReferences>PuzzleCore;PuzzleCore.Jam</PuzzleAllowedProjectReferences></PropertyGroup>

  <Target Name="PuzzleGuardProjectRules" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_PuzzleAllowedReference Include="$(PuzzleAllowedProjectReferences)" />
      <_PuzzleActualReference Include="@(ProjectReference->'%(Filename)')" />
      <_PuzzleForbiddenReference Include="@(_PuzzleActualReference)" Exclude="@(_PuzzleAllowedReference)" />
    </ItemGroup>

    <PropertyGroup>
      <!-- Rules for every project (source and tests). -->
      <_PuzzleProblems Condition="'$(TreatWarningsAsErrors)' != 'true'">$(_PuzzleProblems) TreatWarningsAsErrors must be true;</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(Nullable)' != 'enable'">$(_PuzzleProblems) Nullable must be enable (is '$(Nullable)');</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(CheckForOverflowUnderflow)' != 'true'">$(_PuzzleProblems) CheckForOverflowUnderflow must be true;</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(InvariantGlobalization)' == 'true'">$(_PuzzleProblems) InvariantGlobalization must not be true (it silences the culture analyzers);</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(AllowUnsafeBlocks)' == 'true'">$(_PuzzleProblems) AllowUnsafeBlocks must not be true;</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(NoWarn)' != '1701;1702' and '$(NoWarn)' != ''">$(_PuzzleProblems) NoWarn must stay at the SDK default '1701;1702' (is '$(NoWarn)');</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(WarningsNotAsErrors)' != ''">$(_PuzzleProblems) WarningsNotAsErrors must be empty (is '$(WarningsNotAsErrors)');</_PuzzleProblems>

      <!-- Layering for source projects. -->
      <_PuzzleProblems Condition="'$(PuzzleIsSourceProject)' == 'true' and '$(PuzzleLayeringKnown)' != 'true'">$(_PuzzleProblems) $(MSBuildProjectName) is not in the layering table of Directory.Build.targets;</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(PuzzleIsSourceProject)' == 'true' and '@(_PuzzleForbiddenReference)' != ''">$(_PuzzleProblems) forbidden project references: @(_PuzzleForbiddenReference);</_PuzzleProblems>

      <!-- Assemblies compiled into the Unity client. -->
      <_PuzzleProblems Condition="'$(PuzzleIsUnityBound)' == 'true' and '$(TargetFramework)' != 'netstandard2.1'">$(_PuzzleProblems) TargetFramework must be netstandard2.1 (is '$(TargetFramework)');</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(PuzzleIsUnityBound)' == 'true' and '$(LangVersion)' != '9.0'">$(_PuzzleProblems) LangVersion must be 9.0 (is '$(LangVersion)');</_PuzzleProblems>
      <_PuzzleProblems Condition="'$(PuzzleIsUnityBound)' == 'true' and '@(PackageReference)' != ''">$(_PuzzleProblems) no package references allowed (found: @(PackageReference));</_PuzzleProblems>
    </PropertyGroup>

    <Error Condition="'$(_PuzzleProblems)' != ''" Code="PUZZLE001"
           Text="$(MSBuildProjectName) breaks the engine rules:$(_PuzzleProblems)" />
  </Target>
</Project>
